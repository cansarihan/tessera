{
  "name": "tessera",
  "version": "0.1.0",
  "private": true,
  "description": "Tessera — on-chain event ticketing on Stellar. NFT tickets, QR check-in, anti-fraud and anti-scalping.",
  "author": "Can Sarıhan <sarihancan@icloud.com>",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:sdk": "npm run build -w @tessera/sdk",
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w @tessera/web",
    "dev:api": "npm run dev -w @tessera/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "contract:build": "cd contracts && stellar contract build",
    "contract:test": "cd contracts && cargo test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
